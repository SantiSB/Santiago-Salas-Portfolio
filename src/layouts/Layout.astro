---
import { ViewTransitions } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SmokeBackground from "../components/SmokeBackground.astro";
import ContactDialog from "../components/contact/ContactDialog.astro";
import { SITE } from "../data/site";
import "@fontsource-variable/onest";
import "../styles/global.css";

interface Props {
  lang: "en" | "es";
  title: string;
  description: string;
  /** Path of this view in the current language, e.g. "/projects/" */
  path: string;
  /** Same view in the other language: language switch + hreflang */
  altPath: string;
  active?: string;
  ogImage?: string;
  jsonLd?: Record<string, any>;
}

const {
  lang,
  title,
  description,
  path,
  altPath,
  active,
  ogImage = SITE.ogImage,
  jsonLd,
} = Astro.props;

const canonical = new URL(path, SITE.url).href;
const enHref = new URL(lang === "en" ? path : altPath, SITE.url).href;
const esHref = new URL(lang === "es" ? path : altPath, SITE.url).href;
const image = new URL(ogImage, SITE.url).href;

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.fullName,
  alternateName: SITE.name,
  url: SITE.url,
  image,
  email: `mailto:${SITE.email}`,
  telephone: SITE.phone,
  jobTitle: SITE.role,
  address: { "@type": "PostalAddress", addressCountry: "CO" },
  sameAs: [SITE.linkedin, SITE.github],
  knowsLanguage: ["es", "en"],
  knowsAbout: [
    "React",
    "TypeScript",
    "Frontend Architecture",
    "Design Systems",
    "Testing",
    "Applied AI",
    "Product Engineering",
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.fullName} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/icons/Logo.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="es" href={esHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.fullName} />
    <meta property="og:locale" content={lang === "es" ? "es_CO" : "en_US"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={`${SITE.fullName} — ${SITE.role}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(person)}
      is:inline
    />
    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd)}
          is:inline
        />
      )
    }

    <script is:inline>
      // Applied before first paint, and again after every view transition swap
      (function () {
        const apply = () => {
          const stored = localStorage.getItem("color-theme");
          const dark =
            stored === "dark" ||
            (!stored &&
              window.matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.classList.toggle("dark", dark);
          document.documentElement.classList.add("js");
        };
        apply();
        document.addEventListener("astro:after-swap", apply);
      })();
    </script>

    <ViewTransitions />
  </head>
  <body
    class="flex min-h-screen flex-col text-black dark:text-white"
  >
    <SmokeBackground transition:persist="smoke-bkg" />
    <Header lang={lang} active={active} altPath={altPath} />
    <main id="main" class="flex-1 pt-16 sm:pt-20">
      <slot />
    </main>
    <Footer lang={lang} />
    <ContactDialog lang={lang} />

    <script>
      // Scroll reveal for static content. Re-armed after every view transition.
      function initReveal() {
        const items = document.querySelectorAll(".reveal:not(.is-visible)");
        if (!items.length) return;

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          items.forEach((el) => el.classList.add("is-visible"));
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.04 }
        );

        items.forEach((el) => observer.observe(el));
      }

      document.addEventListener("astro:page-load", initReveal);
    </script>
  </body>
</html>
<style is:global>
  :root {
    color-scheme: light dark;
  }
  html {
    font-family: "Onest Variable", system-ui, sans-serif;
    background-color: #f6f6f6;
  }
  html.dark {
    background-color: #000000;
  }
</style>
