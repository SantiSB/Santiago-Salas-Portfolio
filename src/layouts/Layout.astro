---
import { ViewTransitions } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SmokeBackground from "../components/SmokeBackground.astro";
import ContactDialog from "../components/contact/ContactDialog.astro";
import { SITE } from "../data/site";
import { t } from "../i18n";
// Only the latin subset ships. Fontsource's package entry declares three
// subsets (latin, latin-ext, cyrillic) plus a base64 face, which cost a second
// render-blocking stylesheet; the other two were never even downloaded, since
// `unicode-range` rules them out for English and Spanish.
//
// Importing the file rather than the package CSS is what makes a correct
// preload possible: Vite returns the hashed, immutable URL at build time, so
// the same URL can go in the `@font-face` and in the `<link rel="preload">`.
import onestLatin from "@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url";
import "../styles/global.css";

interface Props {
  lang: "en" | "es";
  title: string;
  description: string;
  /** Path of this view in the current language, e.g. "/projects/" */
  path: string;
  /** Same view in the other language: language switch + hreflang */
  altPath: string;
  active?: string;
  ogImage?: string;
  jsonLd?: Record<string, any>;
  /** Case studies are articles; everything else is a plain page. */
  ogType?: "website" | "article";
}

const {
  lang,
  title,
  description,
  path,
  altPath,
  active,
  ogImage = SITE.ogImage,
  jsonLd,
  ogType = "website",
} = Astro.props;

const canonical = new URL(path, SITE.url).href;
const enHref = new URL(lang === "en" ? path : altPath, SITE.url).href;
const esHref = new URL(lang === "es" ? path : altPath, SITE.url).href;
const image = new URL(ogImage, SITE.url).href;

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.fullName,
  alternateName: SITE.name,
  url: SITE.url,
  image,
  email: `mailto:${SITE.email}`,
  telephone: SITE.phone,
  jobTitle: SITE.role,
  description: t(SITE.positioning, lang),
  address: { "@type": "PostalAddress", addressCountry: "CO" },
  sameAs: [SITE.linkedin, SITE.github],
  knowsLanguage: ["es", "en"],
  knowsAbout: [
    "React",
    "TypeScript",
    "Frontend Architecture",
    "Design Systems",
    "Web Performance",
    "Testing",
    "Applied AI",
    "Product Engineering",
  ],
};

// Declared inline, with the exact same descriptors Fontsource emits, so the
// browser finds the face in the document instead of after parsing a stylesheet.
// The LCP of most views is text, so this is the shortest path to it.
const fontFace = `@font-face{font-family:"Onest Variable";font-style:normal;font-display:swap;font-weight:100 900;src:url(${onestLatin}) format("woff2-variations");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.fullName} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/icons/Logo.svg" />

    {/* The typeface is on the critical path of a text LCP: start it with the
        document, not after the stylesheet. */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={onestLatin}
      crossorigin
    />
    <style is:inline set:html={fontFace}></style>

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="es" href={esHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />

    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#f6f6f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.fullName} />
    <meta
      property="og:locale"
      content={lang === "es" ? "es_CO" : "en_US"}
    />
    <meta
      property="og:locale:alternate"
      content={lang === "es" ? "en_US" : "es_CO"}
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta
      property="og:image:alt"
      content={`${SITE.fullName} — ${t(SITE.positioning, lang)}`}
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta
      name="twitter:image:alt"
      content={`${SITE.fullName} — ${t(SITE.positioning, lang)}`}
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(person)}
      is:inline
    />
    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd)}
          is:inline
        />
      )
    }

    <script is:inline>
      // Applied before first paint, and again after every view transition swap.
      // Light is the default for a first-time visitor; dark is a deliberate
      // choice the visitor makes with the toggle, and it is remembered.
      (function () {
        const apply = () => {
          const dark = localStorage.getItem("color-theme") === "dark";
          document.documentElement.classList.toggle("dark", dark);
          document.documentElement.classList.add("js");
        };
        apply();
        document.addEventListener("astro:after-swap", apply);
      })();
    </script>

    <script is:inline define:vars={{ lang, altPath }}>
      // Language resolution, in order:
      //   1. a preference the visitor saved by using the EN/ES switch
      //   2. the browser language — `es*` gets Spanish, anything else English
      // It only ever runs on a first, direct entry (no in-app history), and it
      // never overrides a URL the visitor explicitly chose. Crawlers are
      // unaffected: canonical and hreflang are already in the served HTML.
      (function () {
        if (window.__langChecked) return;
        window.__langChecked = true;

        let stored = null;
        try {
          stored = localStorage.getItem("preferred-lang");
        } catch {
          return;
        }

        // Anything other than a known language is ignored, so a stale or
        // empty value can never send the visitor into a redirect loop.
        const wanted =
          stored === "en" || stored === "es"
            ? stored
            : (navigator.language || "en").toLowerCase().startsWith("es")
              ? "es"
              : "en";

        if (wanted === lang || !altPath) return;
        window.location.replace(altPath);
      })();
    </script>

    <ViewTransitions />
  </head>
  <body
    class="flex min-h-screen flex-col text-black dark:text-white"
  >
    <SmokeBackground transition:persist="smoke-bkg" />
    <Header lang={lang} active={active} altPath={altPath} />
    <main id="main" class="flex-1 pt-16 sm:pt-20">
      <slot />
    </main>
    <Footer lang={lang} />
    <ContactDialog lang={lang} />

    <script>
      // Scroll reveal for static content. Re-armed after every view transition.
      function initReveal() {
        const items = document.querySelectorAll(".reveal:not(.is-visible)");
        if (!items.length) return;

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          items.forEach((el) => el.classList.add("is-visible"));
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.04 }
        );

        items.forEach((el) => observer.observe(el));
      }

      document.addEventListener("astro:page-load", initReveal);
    </script>
  </body>
</html>
<style is:global>
  /* The theme is driven by the `dark` class, never by the OS preference, so
     color-scheme has to follow the class too (scrollbars, form controls). */
  html {
    color-scheme: light;
    font-family: "Onest Variable", system-ui, sans-serif;
    background-color: #f6f6f6;
  }
  html.dark {
    color-scheme: dark;
    /* Near-black rather than #000: keeps the card borders and the smoke layer
       readable without changing the identity. */
    background-color: #0a0a0a;
  }
</style>
