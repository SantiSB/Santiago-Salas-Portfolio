---
/**
 * Single media surface for every card and detail view.
 *
 * Accepts, via the `media` prop:
 *   { type: "image",   src, alt }   // src is an imported asset: Astro emits
 *                                   // AVIF/WebP at several widths from it
 *   { type: "mockup",  src, alt }                  // same as image, semantic hint only
 *   { type: "video",   src, poster, alt }          // muted, controls, never autoplays
 *   { type: "gallery", items: [{ src, alt }] }     // horizontal scroll-snap, no autoplay
 *   { type: "concept", key: "ai-flow" }
 *   { type: "placeholder" } | null | undefined     // branded fallback
 *
 * `concept` renders a hand-built HTML/SVG drawing from ./visuals — never a
 * screenshot, never an invented interface. Real screenshots always win: swap
 * the `media` object in the data file and nothing else changes.
 */
import { Picture } from "astro:assets";
import { t } from "../../i18n";
import AiFlowVisual from "./visuals/AiFlowVisual.astro";

interface Props {
  media?: any;
  name?: string;
  lang: "en" | "es";
  alt?: string;
  class?: string;
  transitionName?: string;
  eager?: boolean;
  /** `lg` is for full-width surfaces (detail hero, home own-product block). */
  size?: "sm" | "lg";
  /**
   * How wide this surface actually renders, per breakpoint. It must describe
   * the real slot — a generic `100vw` makes the browser download a hero-sized
   * image for a thumbnail — so every call site passes its own.
   */
  sizes?: string;
  /** Candidate widths to emit. Never above the source, which is never upscaled. */
  widths?: number[];
}

const {
  media,
  name = "",
  lang,
  alt,
  class: className = "",
  transitionName,
  eager = false,
  size = "sm",
  sizes = "100vw",
  widths = [280, 560, 840],
} = Astro.props;

const type = media?.type ?? "placeholder";
const label = alt || t(media?.alt, lang) || name;
const loading = eager ? "eager" : "lazy";
const style = transitionName
  ? `view-transition-name:${transitionName}`
  : undefined;

const slug = (name || "media")
  .toLowerCase()
  .normalize("NFD")
  .replace(/[\u0300-\u036f]/g, "")
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/(^-|-$)/g, "");

const words = name.split(/[^\p{L}\p{N}]+/u).filter(Boolean);
const monogram =
  words.length === 0
    ? "SS"
    : words.length === 1
      ? words[0].slice(0, 2).toUpperCase()
      : (words[0][0] + words[1][0]).toUpperCase();

const variant =
  [...(name || "x")].reduce((acc, char) => acc + char.charCodeAt(0), 0) % 3;
const patternId = `pattern-${slug}-${variant}`;
---

<div class={`relative overflow-hidden ${className}`} style={style}>
  {
    /* `fallbackFormat` matters: left to its default the <img> would be PNG,
       heavier than the source and pointless — anything reaching that fallback
       already supports WebP. */
    (type === "image" || type === "mockup") && (
      <Picture
        src={media.src}
        alt={label}
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        widths={widths}
        sizes={sizes}
        loading={loading}
        decoding="async"
        fetchpriority={eager ? "high" : undefined}
        pictureAttributes={{ class: "block h-full w-full" }}
        class="h-full w-full object-cover"
      />
    )
  }

  {type === "concept" && media.key === "ai-flow" && <AiFlowVisual lang={lang} size={size} />}

  {
    type === "video" && (
      <video
        src={media.src}
        poster={media.poster}
        controls
        muted
        playsinline
        preload="metadata"
        aria-label={label}
        class="h-full w-full object-cover"
      />
    )
  }

  {
    type === "gallery" && (
      <ul class="flex h-full w-full snap-x snap-mandatory gap-2 overflow-x-auto">
        {media.items.map((item: any) => (
          <li class="w-full shrink-0 snap-center">
            <img
              src={item.src}
              alt={t(item.alt, lang) || label}
              loading={loading}
              decoding="async"
              width={item.width ?? 1200}
              height={item.height ?? 675}
              class="h-full w-full object-cover"
            />
          </li>
        ))}
      </ul>
    )
  }

  {
    type === "placeholder" && (
      <div
        role="img"
        aria-label={label || name}
        class="flex h-full w-full flex-col items-center justify-center bg-gradient-to-br from-blue-100 via-gray-50 to-blue-200 text-blue-900 dark:from-blue-950 dark:via-gray-950 dark:to-black dark:text-blue-400"
      >
        <svg aria-hidden="true" class="absolute inset-0 h-full w-full opacity-20">
          <defs>
            {variant === 0 && (
              <pattern id={patternId} width="22" height="22" patternUnits="userSpaceOnUse">
                <circle cx="2" cy="2" r="1.4" fill="currentColor" />
              </pattern>
            )}
            {variant === 1 && (
              <pattern
                id={patternId}
                width="40"
                height="40"
                patternUnits="userSpaceOnUse"
                patternTransform="rotate(45)"
              >
                <line x1="0" y1="0" x2="0" y2="40" stroke="currentColor" stroke-width="1.5" />
              </pattern>
            )}
            {variant === 2 && (
              <pattern id={patternId} width="48" height="48" patternUnits="userSpaceOnUse">
                <path
                  d="M0 48 L48 0 M-12 12 L12 -12 M36 60 L60 36"
                  stroke="currentColor"
                  stroke-width="1.5"
                  fill="none"
                />
              </pattern>
            )}
          </defs>
          <rect width="100%" height="100%" fill={`url(#${patternId})`} />
        </svg>

        <span
          aria-hidden="true"
          class="absolute -right-10 -top-16 size-48 rounded-full border border-current opacity-20"
        />

        {/* Branded plate, not a "coming soon" sign: it stands on its own until
            a real asset replaces the `media` entry in the data file. */}
        <div class="relative flex flex-col items-center gap-2.5 px-6 text-center">
          <span class="flex size-12 items-center justify-center rounded-xl border border-blue-900/25 bg-white/60 text-base font-bold dark:border-blue-400/25 dark:bg-black/40">
            {monogram}
          </span>
          <span class="text-xs font-semibold uppercase tracking-[0.2em]">{name}</span>
        </div>
      </div>
    )
  }
</div>
