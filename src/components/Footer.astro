---
import Logo from "./assets/Logo.astro";
import { NAV, UI, t, route } from "../i18n";
import { SITE } from "../data/site";
import { FOCUS, META } from "../styles/ui";

interface Props {
  lang: "en" | "es";
}

const { lang } = Astro.props;
const year = new Date().getFullYear();

const link = `text-[15px] text-gray-700 underline-offset-4 transition-colors hover:text-blue-800 hover:underline dark:text-gray-300 dark:hover:text-blue-400 ${FOCUS} rounded`;
---

<footer class="mt-auto border-t border-gray-200 dark:border-gray-800">
  <div
    class="mx-auto flex w-full max-w-[1120px] flex-col gap-6 px-4 py-8 sm:flex-row sm:items-start sm:justify-between"
  >
    <a href={route("home", lang)} class={`flex items-center gap-3 rounded ${FOCUS}`}>
      <Logo />
      <span class="flex flex-col">
        <span class="text-base font-semibold text-blue-900 dark:text-blue-400"
          >{SITE.fullName}</span
        >
        <span class={META}>{t(SITE.positioning, lang)}</span>
        <span class={META}>{t(SITE.location, lang)}</span>
      </span>
    </a>

    <div class="flex flex-col gap-4 sm:items-end">
      <nav aria-label={lang === "es" ? "Pie de página" : "Footer"}>
        <ul class="flex flex-wrap gap-x-5 gap-y-2">
          {
            NAV.map((item) => (
              <li>
                <a href={route(item.id, lang)} class={link}>
                  {t(item.label, lang)}
                </a>
              </li>
            ))
          }
          <li>
            <a href={route("skills", lang)} class={link}>
              {t(UI.skillsView.title, lang)}
            </a>
          </li>
          <li>
            <button type="button" data-contact-open class={link}>
              {t(UI.nav.contact, lang)}
            </button>
          </li>
        </ul>
      </nav>

      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        <li>
          <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer" class={link}
            >LinkedIn</a
          >
        </li>
        <li>
          <a href={SITE.github} target="_blank" rel="noopener noreferrer" class={link}
            >GitHub</a
          >
        </li>
        <li><a href={`mailto:${SITE.email}`} class={link}>{SITE.email}</a></li>
      </ul>
    </div>
  </div>

  <p class={`pb-6 text-center ${META}`}>
    © {year} {SITE.fullName} · {
      lang === "es"
        ? "Construido con Astro, React y Tailwind CSS"
        : "Built with Astro, React and Tailwind CSS"
    }
  </p>
</footer>
