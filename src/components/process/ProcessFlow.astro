---
/**
 * Five-step flow as a connected sequence instead of five stacked cards:
 * a horizontal line of nodes on desktop, a compact vertical stepper on mobile.
 */
import { t } from "../../i18n";
import { PROCESS } from "../../data/capabilities";

interface Props {
  lang: "en" | "es";
}

const { lang } = Astro.props;
---

<ol class="reveal relative sm:grid sm:grid-cols-5 sm:gap-x-4">
  {/* Connector: vertical on mobile, horizontal on desktop */}
  <span
    aria-hidden="true"
    class="absolute left-[7px] top-2 h-[calc(100%-1rem)] w-px bg-gradient-to-b from-blue-800/40 via-blue-700/25 to-transparent dark:from-blue-400/40 dark:via-blue-400/20 sm:left-0 sm:right-0 sm:top-[7px] sm:h-px sm:w-auto sm:bg-gradient-to-r sm:from-blue-800/40 sm:via-blue-700/25 sm:to-transparent"
  ></span>

  {
    PROCESS.map((step) => (
      <li class="relative flex gap-3 pb-5 last:pb-0 sm:block sm:pb-0">
        <span
          aria-hidden="true"
          class="mt-1 size-3.5 shrink-0 rounded-full border-2 border-blue-800 bg-gray-50 dark:border-blue-400 dark:bg-black sm:mb-3"
        />
        <div class="min-w-0 sm:pr-2">
          <p class="text-sm font-bold text-gray-900 dark:text-white">
            <span class="text-blue-800 dark:text-blue-400">{step.n}</span>
            <span class="mx-1 text-gray-400 dark:text-gray-600">—</span>
            {t(step.title, lang)}
          </p>
          <p class="mt-1 text-xs leading-relaxed text-gray-600 dark:text-gray-400">
            {step.keywords.map((keyword) => t(keyword, lang)).join(" · ")}
          </p>
        </div>
      </li>
    ))
  }
</ol>
