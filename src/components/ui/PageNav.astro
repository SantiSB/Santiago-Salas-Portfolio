---
/**
 * Top navigation strip for every view other than Home:
 * a back control plus a discreet breadcrumb trail.
 *
 * The back control uses real in-app history when the visitor already navigated
 * inside the site, and falls back to the parent route otherwise (direct entry,
 * shared link, search result) — so no view is ever a dead end.
 */
import { t, UI } from "../../i18n";
import { FOCUS } from "../../styles/ui";

interface Props {
  lang: "en" | "es";
  /** Breadcrumb trail, root first. The last item is the current view. */
  items: { label: any; href?: string }[];
  /** Where the back control goes when there is no in-app history. */
  backHref: string;
  /** Named for assistive tech, e.g. "Back: Featured projects". */
  backLabel: any;
  class?: string;
}

const { lang, items, backHref, backLabel, class: className = "" } = Astro.props;
const last = items.length - 1;
---

<div class={`flex items-center gap-3 ${className}`}>
  <a
    href={backHref}
    data-back
    aria-label={`${t(UI.nav.back, lang)}: ${t(backLabel, lang)}`}
    class={`inline-flex size-10 shrink-0 items-center justify-center rounded-full border border-blue-800/40 bg-white/70 text-blue-800 shadow-sm transition-colors hover:border-blue-800 hover:bg-blue-800 hover:text-white dark:border-blue-400/40 dark:bg-gray-900/60 dark:text-blue-400 dark:hover:border-blue-400 dark:hover:bg-blue-400 dark:hover:text-gray-950 ${FOCUS}`}
  >
    <span aria-hidden="true" class="text-lg font-semibold leading-none">←</span>
  </a>

  <nav aria-label={t(UI.nav.breadcrumb, lang)} class="min-w-0">
    <ol class="flex flex-wrap items-center text-sm text-gray-700 dark:text-gray-300">
      {
        items.map((item, index) => (
          <li
            class={`flex items-center ${index < last - 1 ? "hidden sm:flex" : "flex"}`}
          >
            {item.href ? (
              <a
                href={item.href}
                class={`rounded font-medium text-blue-800 underline-offset-4 transition-colors hover:underline dark:text-blue-400 ${FOCUS}`}
              >
                {t(item.label, lang)}
              </a>
            ) : (
              <span
                aria-current="page"
                class="max-w-[52vw] truncate font-semibold text-gray-900 dark:text-white sm:max-w-none"
              >
                {t(item.label, lang)}
              </span>
            )}
            {index < last && (
              <span aria-hidden="true" class="px-2 text-gray-400 dark:text-gray-500">
                /
              </span>
            )}
          </li>
        ))
      }
    </ol>
  </nav>
</div>

<script>
  // Astro's router stamps every history entry it creates with an index, so
  // anything above zero means there is a previous in-app view to go back to.
  //
  // Counting swaps alone was not enough: this script ships with the first page
  // that renders a breadcrumb, so it misses the navigation that brought the
  // visitor there. Arriving at a project straight from the home — which has no
  // breadcrumb — left the counter at zero, and the arrow jumped to the parent
  // route instead of returning to where the visitor actually came from.
  let inAppNavigations = 0;
  document.addEventListener("astro:after-swap", () => {
    inAppNavigations += 1;
  });

  const hasInAppHistory = () =>
    inAppNavigations > 0 || (window.history.state?.index ?? 0) > 0;

  document.addEventListener("click", (event) => {
    const trigger = (event.target as HTMLElement)?.closest?.("[data-back]");
    if (!trigger) return;
    if (!hasInAppHistory()) return; // direct entry: follow the parent href

    event.preventDefault();
    window.history.back();
  });
</script>
