---
import { LINK_ARROW } from "../../styles/ui";

interface Props {
  href: string;
  class?: string;
  external?: boolean;
}

const { href, class: className = "", external = false } = Astro.props;
const extra = external
  ? { target: "_blank", rel: "noopener noreferrer" }
  : {};
---

<a href={href} class={`${LINK_ARROW} ${className}`} {...extra}>
  <slot />
  <span aria-hidden="true" class="transition-transform duration-200">→</span>
</a>
