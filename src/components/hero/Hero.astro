---
import { t, UI, route } from "../../i18n";
import { SITE, HERO } from "../../data/site";
import { BTN_PRIMARY, BTN_SECONDARY, FOCUS } from "../../styles/ui";
import DownloadCV from "../../icons/DownloadCV.astro";

interface Props {
  lang: "en" | "es";
}

const { lang } = Astro.props;

const secondaryLink = `text-sm font-medium text-gray-700 underline-offset-4 transition-colors hover:text-blue-800 hover:underline dark:text-gray-300 dark:hover:text-blue-400 ${FOCUS} rounded`;
---

<section
  class="mx-auto flex min-h-[82svh] w-full max-w-[1120px] flex-col items-center justify-center gap-5 px-4 py-24 text-center sm:gap-6 sm:py-28"
>
  <a
    href={SITE.linkedin}
    target="_blank"
    rel="noopener noreferrer"
    class={`rise inline-flex items-center gap-2 rounded-full border border-blue-800/25 bg-white/70 px-3 py-1 text-xs font-medium text-blue-900 backdrop-blur-sm transition-colors hover:border-blue-800/60 dark:border-blue-400/25 dark:bg-blue-950/40 dark:text-blue-300 dark:hover:border-blue-400/60 ${FOCUS}`}
  >
    <span aria-hidden="true" class="size-1.5 rounded-full bg-emerald-500"></span>
    {t(HERO.badge, lang)}
  </a>

  <h1 class="rise flex flex-col items-center gap-2" style="animation-delay:60ms">
    <span
      class="flex items-center gap-x-3 text-3xl font-bold text-blue-900 dark:text-blue-400 sm:text-4xl lg:text-5xl"
      style="view-transition-name:hero-name"
    >
      {SITE.name}
      <span class="wave" role="img" aria-label={lang === "es" ? "Saludo" : "Waving hand"}>👋</span>
    </span>
    <span
      class="text-xs font-semibold uppercase tracking-[0.2em] text-gray-700 dark:text-gray-300 sm:text-sm"
    >
      {SITE.role}
    </span>
  </h1>

  <ul
    class="rise flex flex-wrap items-center justify-center gap-2"
    style="animation-delay:120ms"
  >
    {
      HERO.stack.map((item) => (
        <li class="rounded-full border border-blue-800/20 bg-white/60 px-3 py-1 text-[11px] font-medium text-blue-900 backdrop-blur-sm dark:border-blue-400/20 dark:bg-blue-950/30 dark:text-blue-300 sm:text-xs">
          {t(item, lang)}
        </li>
      ))
    }
  </ul>

  <p
    class="rise max-w-[24ch] text-balance text-2xl font-bold leading-tight text-gray-900 dark:text-white sm:max-w-[32ch] sm:text-3xl sm:leading-tight lg:text-4xl lg:leading-[1.15]"
    style="animation-delay:180ms"
  >
    {t(HERO.headline, lang)}
  </p>

  <p
    class="rise max-w-[62ch] text-pretty text-sm leading-relaxed text-gray-700 dark:text-gray-300 sm:text-base"
    style="animation-delay:240ms"
  >
    {t(HERO.support, lang)}
  </p>

  <div
    class="rise flex flex-wrap items-center justify-center gap-3"
    style="animation-delay:300ms"
  >
    <a href={route("experience", lang)} class={BTN_PRIMARY}>
      {t(UI.actions.seeExperience, lang)}
      <span aria-hidden="true">→</span>
    </a>
    <a href={SITE.cv} download="Santiago_Salas_CV.pdf" class={BTN_SECONDARY}>
      <DownloadCV class="size-4 fill-none" />
      {t(UI.actions.downloadCv, lang)}
    </a>
  </div>

  <nav
    aria-label={lang === "es" ? "Enlaces de contacto" : "Contact links"}
    class="rise flex flex-wrap items-center justify-center gap-x-5 gap-y-2"
    style="animation-delay:360ms"
  >
    <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer" class={secondaryLink}>
      LinkedIn
    </a>
    <a href={SITE.github} target="_blank" rel="noopener noreferrer" class={secondaryLink}>
      GitHub
    </a>
    <button type="button" data-contact-open class={secondaryLink}>
      {t(UI.actions.contact, lang)}
    </button>
  </nav>
</section>
