---
import { EXPERIENCE } from "../../data/experience";
import ExperienceCard from "./ExperienceCard.astro";

interface Props {
  lang: "en" | "es";
}

const { lang } = Astro.props;
---

<ol class="relative space-y-6 sm:space-y-8">
  {/* Level rail: a static thread, no scroll-driven animation. */}
  <div
    aria-hidden="true"
    class="absolute left-4 top-6 bottom-6 hidden w-px bg-gradient-to-b from-blue-800/50 via-blue-600/30 to-transparent dark:from-blue-400/50 dark:via-blue-400/20 sm:block"
  >
  </div>

  {
    EXPERIENCE.map((item) => (
      <li class="relative sm:pl-14">
        <span
          aria-hidden="true"
          class="absolute left-0 top-6 z-10 hidden size-8 items-center justify-center rounded-full border border-blue-800/30 bg-gray-50 text-[11px] font-bold text-blue-900 dark:border-blue-400/30 dark:bg-black dark:text-blue-400 sm:flex"
        >
          {item.level}
        </span>
        <ExperienceCard item={item} lang={lang} />
      </li>
    ))
  }
</ol>
