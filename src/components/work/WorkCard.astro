---
import { t, UI, workUrl } from "../../i18n";
import Media from "../media/Media.astro";
import Chip from "../ui/Chip.astro";
import { CARD_INTERACTIVE, EYEBROW, BODY, FOCUS } from "../../styles/ui";

interface Props {
  work: any;
  lang: "en" | "es";
  /** `full` adds the summary and technologies; `compact` is for dense grids. */
  variant?: "compact" | "full";
  /** `horizontal` puts the media beside the text on large screens. */
  layout?: "vertical" | "horizontal";
  withTransition?: boolean;
  class?: string;
}

const {
  work,
  lang,
  variant = "compact",
  layout = "vertical",
  withTransition = true,
  class: className = "",
} = Astro.props;

const href = workUrl(work.slug, lang);
const name = t(work.name, lang);
const isFull = variant === "full";
const isRow = layout === "horizontal";
---

<a
  href={href}
  class={`group flex h-full flex-col overflow-hidden ${CARD_INTERACTIVE} ${FOCUS} ${isRow ? "lg:flex-row" : ""} ${className}`}
>
  <Media
    media={work.media}
    name={name}
    lang={lang}
    size={isRow ? "lg" : "sm"}
    transitionName={withTransition ? `media-${work.slug}` : undefined}
    class={`aspect-[16/9] shrink-0 border-b border-gray-200 dark:border-gray-800 ${
      isRow
        ? "lg:aspect-auto lg:w-[46%] lg:border-b-0 lg:border-r"
        : ""
    }`}
  />

  <div
    class={`flex flex-1 flex-col p-4 sm:p-5 ${isRow ? "lg:justify-center lg:p-7" : ""}`}
  >
    <p class={EYEBROW}>{t(work.kind, lang)}</p>
    <h3
      class="mt-1.5 text-lg font-bold text-gray-900 dark:text-white sm:text-xl"
      style={withTransition ? `view-transition-name:title-${work.slug}` : undefined}
    >
      {name}
    </h3>
    <p class="mt-1 text-[15px] font-medium text-blue-800 dark:text-blue-400">
      {t(work.headline, lang)}
    </p>

    {isFull && <p class={`mt-3 ${BODY}`}>{t(work.summary, lang)}</p>}

    {
      isFull && (
        <ul class="mt-4 flex flex-wrap gap-1.5">
          {work.tech.slice(0, 5).map((tech: any) => (
            <li>
              <Chip>{t(tech, lang)}</Chip>
            </li>
          ))}
        </ul>
      )
    }

    <span
      class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-blue-800 dark:text-blue-400"
    >
      {t(UI.actions.seeDetail, lang)}
      <span
        aria-hidden="true"
        class="transition-transform duration-200 group-hover:translate-x-0.5">→</span
      >
    </span>
  </div>
</a>
