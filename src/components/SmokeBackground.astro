---
/**
 * Original smoke particle background, kept as it was: same texture, particle
 * count, sizes, opacity, rotation and frame rate.
 *
 * Only change: the canvas and its 2D context are re-acquired on every
 * `astro:page-load`. The module used to capture them once, which meant that
 * after the first client-side navigation it kept drawing into a detached
 * canvas and the effect disappeared.
 */
---

<div
  id="smoke-bkg"
  class="pointer-events-none fixed inset-0 -z-10 h-full w-full overflow-hidden [contain:paint]"
  aria-hidden="true"
>
  <canvas
    id="smoke-canvas"
    class="block opacity-40 [transform:translateZ(0)] [backface-visibility:hidden] dark:opacity-50"
  ></canvas>
</div>

<script>
  const NUM_PARTICLES = 40; // Número de partículas
  const fps = 30; // Deseado FPS
  const fpsInterval = 800 / fps; // Intervalo de tiempo entre fotogramas

  let canvas: HTMLCanvasElement | null = null;
  let ctx: CanvasRenderingContext2D | null = null;
  let raf = 0;
  let then = Date.now();

  // Carga la textura de humo
  const smokeImage = new Image();
  smokeImage.src = "/images/smoke.webp";

  class Particle {
    x: number;
    y: number;
    size: number;
    opacity: number;
    rotation: number;
    rotationSpeed: number;

    constructor(width: number, height: number) {
      this.x = Math.random() * width - width;
      this.y = Math.random() * height - height / 2;
      this.size = Math.random() * 3000 + 1000; // Ajustar para textura y 'z'
      this.opacity = Math.random() * 0.8; // Opacidad inicial aleatoria
      this.rotation = Math.random() * Math.PI * 2; // Rotación inicial aleatoria
      this.rotationSpeed = Math.random() * 0.002; // Velocidad de rotación
    }

    update() {
      this.rotation += this.rotationSpeed; // Actualizar la rotación
    }

    draw(context: CanvasRenderingContext2D) {
      context.save(); // Guardar el estado actual del contexto
      context.translate(this.x + this.size / 2, this.y + this.size / 2);
      context.rotate(this.rotation); // Rotar
      context.globalAlpha = this.opacity; // Opacidad
      context.drawImage(
        smokeImage,
        -this.size / 2,
        -this.size / 2,
        this.size,
        this.size
      );
      context.globalAlpha = 1.0; // Restablecer opacidad
      context.restore(); // Restaurar el estado original del contexto
    }
  }

  // Particles survive navigations so the effect never restarts visually
  const particles: Particle[] = [];

  function sizeCanvas() {
    if (!canvas) return;
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight + 100;
  }

  function seedParticles() {
    if (!canvas || particles.length) return;
    for (let i = 0; i < NUM_PARTICLES; i++) {
      particles.push(new Particle(canvas.width, canvas.height));
    }
  }

  function handleParticles() {
    if (!ctx || !canvas) return;
    for (let i = 0; i < particles.length; i++) {
      particles[i].update();
      particles[i].draw(ctx);

      if (particles[i].size <= 1) {
        particles.splice(i, 1);
        i--;
        particles.push(new Particle(canvas.width, canvas.height));
      }
    }
  }

  function animate() {
    raf = requestAnimationFrame(animate);

    const now = Date.now();
    const elapsed = now - then;

    if (elapsed > fpsInterval) {
      then = now - (elapsed % fpsInterval);
      ctx?.clearRect(0, 0, canvas?.width ?? 0, canvas?.height ?? 0);
      handleParticles();
    }
  }

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  function bind() {
    const next = document.getElementById(
      "smoke-canvas"
    ) as HTMLCanvasElement | null;
    if (!next) return;

    // Already drawing into this exact canvas: nothing to do
    if (next === canvas && ctx) return;

    canvas = next;
    ctx = canvas.getContext("2d");
    sizeCanvas();
    seedParticles();

    if (reducedMotion.matches) return;

    cancelAnimationFrame(raf);
    if (smokeImage.complete) {
      animate();
    } else {
      smokeImage.onload = () => animate();
    }
  }

  // Resizing the canvas wipes its buffer, so it must not happen while scrolling.
  // Mobile browsers fire `resize` when the URL bar shows/hides, which produced a
  // visible flash; only a real width change (or a large height change) rebuilds it.
  let lastWidth = window.innerWidth;
  let lastHeight = window.innerHeight;
  let resizeTimer = 0;

  window.addEventListener(
    "resize",
    () => {
      const widthChanged = window.innerWidth !== lastWidth;
      const heightJump = Math.abs(window.innerHeight - lastHeight) > 160;
      if (!widthChanged && !heightJump) return;

      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        lastWidth = window.innerWidth;
        lastHeight = window.innerHeight;
        sizeCanvas();
        // The animation loop keeps running: no cancel, no restart, no flash
      }, 150);
    },
    { passive: true }
  );

  document.addEventListener("astro:page-load", bind);
</script>
