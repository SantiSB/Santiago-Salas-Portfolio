---
import { t, UI } from "../../i18n";
import { SITE } from "../../data/site";
import { BTN_PRIMARY, BTN_SECONDARY, EYEBROW, BODY, META } from "../../styles/ui";
import DownloadCV from "../../icons/DownloadCV.astro";

interface Props {
  lang: "en" | "es";
}

const { lang } = Astro.props;
---

<section id="contact" class="mx-auto w-full max-w-[1120px] px-4 py-10 sm:py-14">
  <div
    class="reveal rounded-xl border border-blue-800/25 bg-white/70 p-6 backdrop-blur-sm dark:border-blue-400/25 dark:bg-gray-900/60 sm:p-9"
  >
    <p class={EYEBROW}>{t(UI.contact.eyebrow, lang)}</p>
    <h2
      class="mt-2 text-balance text-xl font-bold text-blue-900 dark:text-blue-400 sm:text-3xl"
    >
      {t(UI.contact.available, lang)}
    </h2>
    <p class={`mt-3 max-w-2xl ${BODY}`}>{t(UI.contact.body, lang)}</p>
    <p class={`mt-2 max-w-2xl ${META}`}>{t(UI.contact.roles, lang)}</p>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <button type="button" data-contact-open class={BTN_PRIMARY}>
        {t(UI.actions.contact, lang)}
        <span aria-hidden="true">→</span>
      </button>
      <a href={SITE.cv} download="Santiago_Salas_CV.pdf" class={BTN_SECONDARY}>
        <DownloadCV class="size-4 fill-none" />
        {t(UI.actions.downloadCv, lang)}
      </a>
    </div>

    <p class={`mt-5 ${META}`}>
      {SITE.email} · {t(SITE.location, lang)}
    </p>
  </div>
</section>
