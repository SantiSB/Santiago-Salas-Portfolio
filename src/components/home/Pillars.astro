---
import { t, UI } from "../../i18n";
import { PILLARS } from "../../data/site";
import { CARD, BODY } from "../../styles/ui";

interface Props {
  lang: "en" | "es";
}

const { lang } = Astro.props;
---

<section class="mx-auto w-full max-w-[1120px] px-4 py-8 sm:py-12">
  <h2
    class="reveal max-w-2xl text-lg font-bold text-blue-900 dark:text-blue-400 sm:text-2xl"
  >
    {t(UI.home.pillars.title, lang)}
  </h2>

  <div
    class={`reveal mt-5 divide-y divide-gray-200 dark:divide-gray-800 sm:grid sm:grid-cols-3 sm:divide-x sm:divide-y-0 ${CARD}`}
  >
    {
      PILLARS.map((pillar) => (
        <div class="p-4 sm:p-5">
          <h3 class="text-xs font-bold uppercase tracking-[0.16em] text-blue-900 dark:text-blue-400">
            {t(pillar.title, lang)}
          </h3>
          <p class={`mt-1.5 ${BODY}`}>{t(pillar.body, lang)}</p>
        </div>
      ))
    }
  </div>
</section>
