---
import { t, UI, route } from "../../i18n";
import { EXPERIENCE } from "../../data/experience";
import SectionHeading from "../ui/SectionHeading.astro";
import ArrowLink from "../ui/ArrowLink.astro";
import { CARD, META } from "../../styles/ui";

interface Props {
  lang: "en" | "es";
}

const { lang } = Astro.props;
---

<section class="mx-auto w-full max-w-[1120px] px-4 py-8 sm:py-12">
  <div class="reveal flex flex-wrap items-end justify-between gap-4">
    <SectionHeading
      lang={lang}
      eyebrow={UI.home.path.eyebrow}
      title={UI.home.path.title}
    />
    <ArrowLink href={route("experience", lang)}>
      {t(UI.actions.seeFullPath, lang)}
    </ArrowLink>
  </div>

  <ol
    class={`reveal mt-6 divide-y divide-gray-200 dark:divide-gray-800 lg:grid lg:grid-cols-4 lg:divide-x lg:divide-y-0 ${CARD}`}
  >
    {
      EXPERIENCE.map((item) => (
        <li class="flex items-baseline gap-3 p-4 lg:flex-col lg:gap-1">
          <span class="text-xs font-bold tracking-[0.2em] text-blue-800 dark:text-blue-400">
            {item.level}
          </span>
          <div class="min-w-0">
            <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-gray-600 dark:text-gray-400">
              {t(item.levelLabel, lang)}
            </p>
            <p class="mt-0.5 truncate text-sm font-semibold text-gray-900 dark:text-white">
              {item.company}
            </p>
            <p class={`mt-0.5 ${META}`}>{t(item.dates, lang)}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>
