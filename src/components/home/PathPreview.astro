---
import { t, UI, route } from "../../i18n";
import { EXPERIENCE } from "../../data/experience";
import SectionHeading from "../ui/SectionHeading.astro";
import ArrowLink from "../ui/ArrowLink.astro";
import { CARD, META, BODY } from "../../styles/ui";

interface Props {
  lang: "en" | "es";
}

const { lang } = Astro.props;
---

<section class="mx-auto w-full max-w-[1120px] px-4 py-8 sm:py-12">
  {/* Same card, accent border and padding as the own-product block: career and
      own product are the two pillars of the home and should weigh the same. */}
  <article
    class={`reveal overflow-hidden p-5 sm:p-7 ${CARD} border-blue-800/25 dark:border-blue-400/25`}
  >
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeading
        lang={lang}
        eyebrow={UI.home.path.eyebrow}
        title={UI.home.path.title}
      />
      <ArrowLink href={route("experience", lang)}>
        {t(UI.actions.seeFullPath, lang)}
      </ArrowLink>
    </div>

    {/* Four stages as four cards, 2×2: room for the company, the period and a
        line on what the stage was about, instead of a cramped four-column strip. */}
    <ol class="mt-6 grid gap-3 sm:grid-cols-2 sm:gap-4">
      {
        EXPERIENCE.map((item) => (
          <li class={`p-5 sm:p-6 ${CARD}`}>
            <div class="flex items-center gap-2.5">
              <span class="text-sm font-bold tracking-[0.2em] text-blue-800 dark:text-blue-400">
                {item.level}
              </span>
              <span class="text-[11px] font-semibold uppercase tracking-[0.16em] text-gray-600 dark:text-gray-300">
                {t(item.levelLabel, lang)}
              </span>
            </div>
            <p class="mt-2 text-lg font-bold text-gray-900 dark:text-white">
              {item.company}
            </p>
            <p class={`mt-0.5 ${META}`}>{t(item.dates, lang)}</p>
            <p class={`mt-3 ${BODY}`}>{t(item.summary, lang)}</p>
          </li>
        ))
      }
    </ol>
  </article>
</section>
